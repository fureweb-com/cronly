{
  "name": "@fureweb/cronly",
  "version": "1.0.0",
  "description": "Schedule JavaScript scripts for everyday jobs, with cron expressions when you need them.",
  "type": "module",
  "files": [
    "bin/",
    "lib/"
  ],
  "bin": {
    "cronly": "./bin/cronly.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.mjs",
    "test:coverage": "c8 --100 --reporter=text --reporter=lcov node test/test.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fureweb-com/cronly.git"
  },
  "homepage": "https://github.com/fureweb-com/cronly#readme",
  "bugs": {
    "url": "https://github.com/fureweb-com/cronly/issues"
  },
  "keywords": [
    "javascript",
    "script",
    "crontab",
    "cron",
    "cli",
    "scheduler"
  ],
  "author": "fureweb.com@gmail.com",
  "license": "MIT",
  "engines": {
    "node": ">=14.8.0"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
